# Configurações do Banco de Dados PostgreSQL
DB_HOST=matbloom-db
DB_PORT=5432
DB_NAME=matbloom
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@matbloom-db:5432/matbloom

# Configurações da API
API_HOST=0.0.0.0
API_PORT=8000

# URL da API para o Frontend
REACT_APP_API_URL=http://localhost:8000  # ou URL do serviço em produção

# Configurações de Autenticação
SECRET_KEY=altere_para_uma_chave_secreta_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=matbloom_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
AUTO_MIGRATE=true
SEED_MOCK_DATA=if-empty

# Configurações de API Externa (Groq)
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.3
GROQ_MAX_COMPLETION_TOKENS=1400
